# Copy this file to .env and fill in your Supabase project values.
# The anon/publishable key is a PUBLIC client key (safe to expose) — it is gated by
# Supabase row-level security. Do NOT put the service_role key here or anywhere in the frontend.

# Used by the Vite client build (import.meta.env.*)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"

# Server-side fallbacks (SSR) — same values, non-VITE names
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"

# Where the "Run campaign" button POSTs to. Falls back to the old n8n webhook
# if unset, so this is safe to leave blank until the backend/ server is
# actually deployed somewhere. Once it is, point this at <backend-url>/run-campaign.
VITE_RUN_CAMPAIGN_URL="http://localhost:8787/run-campaign"
